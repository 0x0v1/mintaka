---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { image, displayText, hideCardText = false, transparentBg = false, project, link, description, class: className } = Astro.props;
---

<li class:list={["flex flex-col", className]}>
	<a href={translatePath(link)} aria-label={`Project ${project}`}>
		<div
			class="flex h-[25rem] w-full flex-col items-center justify-center rounded-md bg-black p-8 text-center text-white md:w-[calc(100%+2rem)] lg:w-[calc(100%+4rem)] lg:rounded-lg lg:p-10">
			<div>
				<p class="text-6xl font-bold uppercase leading-none tracking-normal md:text-8xl">{project}</p>
				{description && <p class="mx-auto mt-6 max-w-sm text-base leading-8 text-zinc-400">{description}</p>}
			</div>
		</div>
	</a>
	<div class="px-2 py-8">
		<a href={translatePath(link)} class="flex items-center justify-between text-base font-medium lg:gap-x-8">
			<h3 class="text-base font-semibold uppercase leading-8 md:mt-0">
				{project}
			</h3>
			<span class="text-right text-base hover:text-primary-700">
				<span class="hidden lg:inline-block">{t("projects.see")}</span>
				<span class="sr-only">{project}</span> &nbsp; &rarr;
			</span>
		</a>
		{description && <p class="mt-8 line-clamp-2 text-sm text-slate-500">{description}</p>}
	</div>
</li>
