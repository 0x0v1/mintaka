---
import { getCollection } from "astro:content";
import WokCard from "@components/work/WokCard.astro";
import { getLangFromUrl } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);

const { class: className } = Astro.props;

const projectDetails: Record<string, { summary: string }> = {
	ward: {
		summary:
			"Open-source Android evidence collection and structured device triage. WARD helps people preserve useful artefacts and identify activity that needs deeper review.",
	},
	mesh: {
		summary:
			"Consent-based remote evidence collection for cases where an investigator cannot reach the device. MESH is designed to be self-hosted by the communities using it.",
	},
};

const projectOrder = ["ward", "mesh"];

const allProjects = (await getCollection("projects"))
	.filter((prj) => {
		const [postLang, ...slug] = prj.slug.split("/");
		return postLang === lang;
	})
	.map((prj) => {
		const [postLang, slug] = prj.slug.split("/");

		return {
			...prj,
			slug: slug,
		};
	})
	.sort((a, b) => {
		const aIndex = projectOrder.indexOf(a.slug);
		const bIndex = projectOrder.indexOf(b.slug);
		return (aIndex === -1 ? projectOrder.length : aIndex) - (bIndex === -1 ? projectOrder.length : bIndex);
	});
---

<section id="projects" class:list={["section work-preview-section bg-slate-50 py-24 text-zinc-950 lg:py-40", className]}>
	<div class="col-span-12 col-start-1 mx-auto w-full max-w-7xl">
		<ol class="flex flex-col gap-32 lg:gap-0">
			{
				allProjects.map((project, index) => {
					const details = projectDetails[project.slug];
					return (
						<WokCard
							image={project.data.image?.source}
							imageAlt={project.data.image?.alt}
							project={project.data.title}
							link={`/work/${project.slug}`}
							description={details?.summary ?? project.data.description}
							reverse={index % 2 === 1}
							invertArtwork={project.slug === "mesh"}
						/>
					);
				})
			}
		</ol>
	</div>
</section>
