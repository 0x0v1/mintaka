---
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const workAreas = [
	{
		title: "Forensics commons",
		content:
			"We reduce dependence on big tech and closed forensic services by turning offensive security work and DFIR practice into shared methods, tools, and capabilities that civil-society labs can adapt locally.",
	},
	{
		title: "Security research",
		content:
			"We uncover and responsibly disclose software vulnerabilities, study overlooked attack classes, and use that research to shape defensive tools, forensic methods, and civil-society security capacity.",
	},
	{
		title: "Research and disclosure",
		content:
			"We publish technical findings when they help defenders, coordinate when coordination reduces harm, and avoid turning active incidents into spectacle.",
	},
];
---

<section id="operating-standards" class:list={["section home-dark-section bg-zinc-900 py-20 text-white lg:py-32", className]}>
	<div class="col-span-12 mx-auto w-full max-w-7xl">
		<div class="max-w-5xl">
			<h2 class="max-w-4xl text-3xl font-semibold leading-tight tracking-normal text-white sm:text-4xl lg:text-5xl">
				We support civil society and research partners investigating spyware, mobile surveillance, and digital repression.
			</h2>
			<p class="mt-8 max-w-3xl text-base leading-8 text-zinc-300 md:text-lg">
				Our mission is to decentralize threat research. As a security research and development team, our security research informs our
				development, translating offensive and defensive security into actionable open-source technologies.
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a
					href={translatePath("/blog/")}
					class="inline-flex h-10 items-center justify-center rounded bg-white px-4 text-sm font-semibold text-zinc-950 transition hover:bg-zinc-200">
					Read research
				</a>
				<a
					href={translatePath("/escalation/")}
					class="inline-flex h-10 items-center justify-center rounded border border-zinc-600 px-4 text-sm font-semibold text-white transition hover:border-zinc-300 hover:bg-zinc-800">
					Escalate a case
				</a>
			</div>
		</div>

		<ol class="mt-20 grid gap-10 lg:grid-cols-3 lg:gap-12">
			{
				workAreas.map(({ title, content }) => (
					<li>
						<div class="max-w-md">
							<h3 class="text-2xl font-semibold leading-tight tracking-normal text-white">{title}</h3>
							<p class="mt-5 text-base leading-8 text-zinc-400">{content}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
