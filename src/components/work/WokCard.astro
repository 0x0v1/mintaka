---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { image, imageAlt = "", project, link, description, reverse = false, invertArtwork = false, class: className } = Astro.props;
---

<li class:list={["project-entry relative lg:min-h-[42rem]", reverse ? "lg:-mt-20" : "", className]}>
	<a href={translatePath(link)} aria-label={`Project ${project}`} class="project-link flex flex-col lg:block">
		<div
			class:list={[
				"project-art flex items-center justify-center",
				reverse ? "lg:absolute lg:-left-[7%] lg:top-4 lg:w-[67%]" : "lg:absolute lg:-right-[8%] lg:top-0 lg:w-[72%]",
			]}>
			{
				image && (
					<Image
						src={image}
						alt={imageAlt}
						widths={[480, 768, 1200]}
						sizes="(min-width: 1024px) 65vw, 100vw"
						class:list={["h-auto w-full mix-blend-multiply", invertArtwork ? "invert" : ""]}
					/>
				)
			}
		</div>

		<div
			class:list={[
				"project-copy relative z-10 mt-8 max-w-md lg:absolute lg:mt-0",
				reverse ? "lg:right-[3%] lg:top-40" : "lg:left-[3%] lg:top-40",
			]}>
			<h3 class="sr-only">{project}</h3>
			<p class="text-lg leading-8 text-zinc-800">{description}</p>
			<p class="project-action mt-7 inline-flex items-center gap-3 text-sm font-semibold uppercase tracking-wide">
				{t("projects.see")}
				<span aria-hidden="true">→</span>
			</p>
		</div>
	</a>
</li>

<style>
	.project-art img,
	.project-action {
		transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-link:hover .project-art img,
	.project-link:focus-visible .project-art img {
		transform: translateY(-0.4rem) rotate(-0.35deg);
	}

	.project-link:hover .project-action,
	.project-link:focus-visible .project-action {
		transform: translateX(0.35rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-art img,
		.project-action {
			transition: none;
		}
	}
</style>
